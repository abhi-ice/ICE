# Production builds
/build
dist/
dist

# Secrets that must never be committed
*token.json*
*credentials.json*
credentials.json
.credentials
*.pem
*.key

# 2026-07-06 -- Emergent k8s deploys build the production container
# straight from the git repo (no separate secret plumbing on this app),
# so backend/.env and frontend/.env MUST stay tracked. Historic
# `-e`-prefixed .env blocks that used to sit here caused four straight
# deploy failures because MONGO_URL was missing in the container ->
# _ensure_indexes() hung -> readiness probe timed out.
# DO NOT re-add `.env` / `*.env` blanket ignores.
# Only local overlays are ignored below.
*.env.local
.env.local
.env.*.local

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

