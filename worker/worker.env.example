# ICE Site Ops — Microsoft Project worker settings.
#
# Copy this file to worker.env (same folder) and fill in the two required
# lines below. Lines starting with # are ignored. Environment variables with
# the same names override anything set here.

# REQUIRED. Web address of your ICE site (no path, no trailing slash needed).
ICE_BASE_URL=https://field-ops-hub-21.preview.emergentagent.com

# REQUIRED. Paste the connector token from ICE:
# Settings -> Microsoft Project connector. Keep this file private.
MS_PROJECT_WORKER_TOKEN=paste-your-token-here

# Optional. Seconds each "ask ICE for work" call waits for a job (1-25).
#POLL_SECONDS=20

# Optional. Show the Microsoft Project window while the worker drives it
# (true/false). Useful for watching what happens; leave false normally.
#MSP_VISIBLE=false

# Optional. The name this worker reports to ICE. Default: this computer's name.
#WORKER_ID=site-office-pc

# Optional. Folder holding your Microsoft Project files, one per ICE project,
# each named <ICE project id>.mpp. Default: a "projects" folder next to
# msp_worker.py. (An ICE admin can instead pin an exact file path on the
# project itself, which takes precedence.)
#MSP_PROJECT_DIR=C:\ICE\projects
